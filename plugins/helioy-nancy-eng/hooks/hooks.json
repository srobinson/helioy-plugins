{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git log --oneline -6; echo; echo '(git log --format=full <hash> for deeper context on any commit)'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "fmm generate; true"
          }
        ]
      }
    ],
    "SessionEnd": []
  }
}
