{
  "mcpServers": {
    "am": {
      "command": "/Users/alphab/Dev/LLM/DEV/helioy/attention-matters/target/release/am",
      "args": ["serve"]
    },
    "cm": {
      "command": "/Users/alphab/.cargo/bin/cm",
      "args": ["serve"],
      "env": {
        "CM_RECALL_RANKING": "shadow"
      },
      "alwaysLoad": true 
    },
    "fmm": {
      "command": "/Users/alphab/.cargo/bin/fmm",
      "args": ["serve"]
    },
    "mdm": {
      "command": "/Users/alphab/.local/share/mise/installs/node/25/bin/node",
      "args": [
        "/Users/alphab/Dev/LLM/DEV/helioy/markdown-matters/dist/mcp/server.js"
      ],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}
