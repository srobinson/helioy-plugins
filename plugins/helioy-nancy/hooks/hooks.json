{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$NANCY_SESSION_ID\" ] || echo 'Your primary memory is context-matters (cm) via cx_* MCP tools. Call cx_browse(limit: 3). This ensures session continuity. Do this BEFORE responding or exploring the codebase. After meaningful work, call cx_deposit to persist facts, decisions, and lessons learned.'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_ROOT=\"/Users/alphab/Dev/LLM/DEV/helioy/helioy-plugins/plugins/helioy-tools\"; \"$HOOK_ROOT/hooks/fmm-quiet-generate.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_ROOT=\"/Users/alphab/Dev/LLM/DEV/helioy/helioy-plugins/plugins/helioy-tools\"; \"$HOOK_ROOT/hooks/fmm-quiet-generate.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_ROOT=\"/Users/alphab/Dev/LLM/DEV/helioy/helioy-plugins/plugins/helioy-tools\"; \"$HOOK_ROOT/hooks/fmm-quiet-generate.sh\""
          }
        ]
      }
    ],
    "SessionEnd": []
  }
}
